#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"Emails with <b style='color: #000000; font-weight: 500;'>personalized "
"subject lines</b> get <b style='color: #000000; font-weight: 500;'>higher "
"open rates </b> — try adding the recipient's name."
msgstr ""
"E-Mails mit <b style='color: #000000; font-weight: 500;'>personalisierten Betreffzeilen</b> erzielen <b style='color: #000000; font-weight: 500;'>höhere Öffnungsraten</b> – versuchen Sie, den Namen des Empfängers hinzuzufügen."

#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"<b style='color: #000000; font-weight: 500;'>Resending to non-openers after "
"48 hours</b> can <b style='color: #000000; font-weight: 500;'>increase reach "
"by 10–20%</b>."
msgstr ""
"<b style='color: #000000; font-weight: 500;'>Erneutes Versenden an Nicht-Öffner nach 48 Stunden</b> kann die <b style='color: #000000; font-weight: 500;'>Reichweite um 10–20% erhöhen</b>."

#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"Adding <b style='color: #000000; font-weight: 500;'>clear CTAs</b> (like "
"'Shop Now' or 'Read More') <b style='color: #000000; font-weight: "
"500;'>improves click rates</b>."
msgstr ""
"Das Hinzufügen <b style='color: #000000; font-weight: 500;'>klarer CTAs</b> (wie 'Jetzt einkaufen' oder 'Mehr lesen') <b style='color: #000000; font-weight: 500;'>verbessert die Klickraten</b>."

#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"<b style='color: #000000; font-weight: 500;'>High image-to-text ratio</b> "
"can <b style='color: #000000; font-weight: 500;'> trigger spam filters</b> — "
"maintain balance."
msgstr ""
"<b style='color: #000000; font-weight: 500;'>Hohes Bild-zu-Text-Verhältnis</b> kann <b style='color: #000000; font-weight: 500;'>Spam-Filter auslösen</b> – halten Sie die Balance."

#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"<b style='color: #000000; font-weight: 500;'>Geolocation-based timing</b> "
"improves <b style='color: #000000; font-weight: 500;'>open rates for global "
"audiences</b>"
msgstr ""
"<b style='color: #000000; font-weight: 500;'>Geolokationsbasiertes Timing</b> verbessert die <b style='color: #000000; font-weight: 500;'>Öffnungsraten für globale Zielgruppen</b>"

#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"<b style='color: #000000; font-weight: 500;'>Shorter subject lines (<50 "
"characters)</b> perform better on <b style='color: #000000; font-weight: "
"500;'>mobile devices</b>."
msgstr ""
"<b style='color: #000000; font-weight: 500;'>Kürzere Betreffzeilen (<50 Zeichen)</b> funktionieren besser auf <b style='color: #000000; font-weight: 500;'>Mobilgeräten</b>."

#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"<b style='color: #000000; font-weight: 500;'>Birthday or anniversary emails</"
"b> often see <b style='color: #000000; font-weight: 500;'>4x higher "
"engagement</b>."
msgstr ""
"<b style='color: #000000; font-weight: 500;'>Geburtstags- oder Jubiläums-E-Mails</b> erzielen oft <b style='color: #000000; font-weight: 500;'>4-mal höheres Engagement</b>."

#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"Avoid <b style='color: #000000; font-weight: 500;'>spammy trigger words</b> "
"like <b style='color: #000000; font-weight: 500;'>free!!!</b>, <b "
"style='color: #000000; font-weight: 500;'>urgent</b>, or <b style='color: "
"#000000; font-weight: 500;'>act now</b> in <b style='color: #000000; font-"
"weight: 500;'>subject lines</b>."
msgstr ""
"Vermeiden Sie <b style='color: #000000; font-weight: 500;'>spam-verdächtige Trigger-Wörter</b> wie <b style='color: #000000; font-weight: 500;'>gratis!!!</b>, <b style='color: #000000; font-weight: 500;'>dringend</b> oder <b style='color: #000000; font-weight: 500;'>jetzt handeln</b> in <b style='color: #000000; font-weight: 500;'>Betreffzeilen</b>."

#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"Adding <b style='color: #000000; font-weight: 500;'>emojis to subject lines</"
"b> can <b style='color: #000000; font-weight: 500;'>boost opens</b> — but "
"use them sparingly."
msgstr ""
"Das Hinzufügen von <b style='color: #000000; font-weight: 500;'>Emojis zu Betreffzeilen</b> kann <b style='color: #000000; font-weight: 500;'>die Öffnungsraten steigern</b> – verwenden Sie sie jedoch sparsam."

#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"<b style='color: #000000; font-weight: 500;'>Engagement drops</b> when <b "
"style='color: #000000; font-weight: 500;'>sending frequency changes</b> too "
"often."
msgstr ""
"<b style='color: #000000; font-weight: 500;'>Das Engagement sinkt</b>, wenn sich die <b style='color: #000000; font-weight: 500;'>Versandfrequenz zu oft ändert</b>."

#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"Avoid sending <b style='color: #000000; font-weight: 500;'>too many "
"promotional emails back-to-back</b>."
msgstr ""
"Vermeiden Sie das Senden von <b style='color: #000000; font-weight: 500;'>zu vielen Werbe-E-Mails hintereinander</b>."

#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"Your <b style='color: #000000; font-weight: 500;'>preview text</b> can <b "
"style='color: #000000; font-weight: 500;'>double open rates</b> — don't "
"leave it blank."
msgstr ""
"Ihr <b style='color: #000000; font-weight: 500;'>Vorschautext</b> kann die <b style='color: #000000; font-weight: 500;'>Öffnungsraten verdoppeln</b> – lassen Sie ihn nicht leer."

#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"Use <b style='color: #000000; font-weight: 500;'>consistent brand colors and "
"fonts</b> to build <b style='color: #000000; font-weight: 500;'>recognition</"
"b>."
msgstr ""
"Verwenden Sie <b style='color: #000000; font-weight: 500;'>einheitliche Markenfarben und Schriftarten</b>, um <b style='color: #000000; font-weight: 500;'>Wiedererkennung aufzubauen</b>."

#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"<b style='color: #000000; font-weight: 500;'>White space</b> improves <b "
"style='color: #000000; font-weight: 500;'>readability</b> — don't cram too "
"much content."
msgstr ""
"<b style='color: #000000; font-weight: 500;'>Weißraum</b> verbessert die <b style='color: #000000; font-weight: 500;'>Lesbarkeit</b> – packen Sie nicht zu viel Inhalt hinein."

#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"Include <b style='color: #000000; font-weight: 500;'>alt text</b> for all "
"images for <b style='color: #000000; font-weight: 500;'>accessibility and "
"fallback</b>."
msgstr ""
"Fügen Sie <b style='color: #000000; font-weight: 500;'>Alt-Text</b> für alle Bilder hinzu für <b style='color: #000000; font-weight: 500;'>Barrierefreiheit und Fallback</b>."

#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"Keep <b style='color: #000000; font-weight: 500;'>paragraph length under 3 "
"lines</b> for better <b style='color: #000000; font-weight: 500;'>mobile "
"reading</b>."
msgstr ""
"Halten Sie die <b style='color: #000000; font-weight: 500;'>Absatzlänge unter 3 Zeilen</b> für besseres <b style='color: #000000; font-weight: 500;'>mobiles Lesen</b>."

#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"<b style='color: #000000; font-weight: 500;'>Segmenting by engagement score</"
"b> boosts <b style='color: #000000; font-weight: 500;'>deliverability</b>."
msgstr ""
"<b style='color: #000000; font-weight: 500;'>Segmentierung nach Engagement-Bewertung</b> verbessert die <b style='color: #000000; font-weight: 500;'>Zustellbarkeit</b>."

#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"<b style='color: #000000; font-weight: 500;'>New subscribers</b> engage <b "
"style='color: #000000; font-weight: 500;'>3x more</b> — <b style='color: "
"#000000; font-weight: 500;'>nurture them early</b>."
msgstr ""
"<b style='color: #000000; font-weight: 500;'>Neue Abonnenten</b> engagieren sich <b style='color: #000000; font-weight: 500;'>3-mal mehr</b> – <b style='color: #000000; font-weight: 500;'>pflegen Sie sie frühzeitig</b>."

#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"Use <b style='color: #000000; font-weight: 500;'>polls or surveys</b> to "
"learn what <b style='color: #000000; font-weight: 500;'>content your "
"subscribers prefer</b>."
msgstr ""
"Verwenden Sie <b style='color: #000000; font-weight: 500;'>Umfragen</b>, um zu erfahren, welche <b style='color: #000000; font-weight: 500;'>Inhalte Ihre Abonnenten bevorzugen</b>."

#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"Adding a <b style='color: #000000; font-weight: 500;'>P.S. line</b> "
"increases <b style='color: #000000; font-weight: 500;'>responses</b> — "
"readers often <b style='color: #000000; font-weight: 500;'>skim to it</b>."
msgstr ""
"Das Hinzufügen einer <b style='color: #000000; font-weight: 500;'>P.S.-Zeile</b> erhöht die <b style='color: #000000; font-weight: 500;'>Antworten</b> – Leser überfliegen sie oft <b style='color: #000000; font-weight: 500;'>direkt</b>."

#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"Get a complete view of your contacts so you can personalize messaging, "
"strengthen relationships."
msgstr ""
"Erhalten Sie eine vollständige Übersicht über Ihre Kontakte, damit Sie Nachrichten personalisieren und Beziehungen stärken können."

