#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"Emails with <b style='color: #000000; font-weight: 500;'>personalized "
"subject lines</b> get <b style='color: #000000; font-weight: 500;'>higher "
"open rates </b> \u2014 try adding the recipient's name."
msgstr "Le email con <b style='color: #000000; font-weight: 500;'>oggetti personalizzati</b> ottengono <b style='color: #000000; font-weight: 500;'>tassi di apertura più alti</b> \u2014 prova ad aggiungere il nome del destinatario."

#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"<b style='color: #000000; font-weight: 500;'>Resending to non-openers after "
"48 hours</b> can <b style='color: #000000; font-weight: 500;'>increase reach "
"by 10\u201320%</b>."
msgstr "<b style='color: #000000; font-weight: 500;'>Inviare nuovamente a chi non ha aperto dopo 48 ore</b> può <b style='color: #000000; font-weight: 500;'>aumentare la portata del 10\u201320%</b>."

#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"Adding <b style='color: #000000; font-weight: 500;'>clear CTAs</b> (like "
"'Shop Now' or 'Read More') <b style='color: #000000; font-weight: "
"500;'>improves click rates</b>."
msgstr "Aggiungere <b style='color: #000000; font-weight: 500;'>CTA chiari</b> (come 'Acquista Ora' o 'Leggi di Più') <b style='color: #000000; font-weight: 500;'>migliora i tassi di clic</b>."

#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"<b style='color: #000000; font-weight: 500;'>High image-to-text ratio</b> "
"can <b style='color: #000000; font-weight: 500;'> trigger spam filters</b> \u2014 "
"maintain balance."
msgstr "<b style='color: #000000; font-weight: 500;'>Un alto rapporto immagini-testo</b> può <b style='color: #000000; font-weight: 500;'>attivare i filtri antispam</b> \u2014 mantieni l'equilibrio."

#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"<b style='color: #000000; font-weight: 500;'>Geolocation-based timing</b> "
"improves <b style='color: #000000; font-weight: 500;'>open rates for global "
"audiences</b>"
msgstr "<b style='color: #000000; font-weight: 500;'>La tempistica basata sulla geolocalizzazione</b> migliora <b style='color: #000000; font-weight: 500;'>i tassi di apertura per il pubblico globale</b>"

#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"<b style='color: #000000; font-weight: 500;'>Shorter subject lines (<50 "
"characters)</b> perform better on <b style='color: #000000; font-weight: "
"500;'>mobile devices</b>."
msgstr "<b style='color: #000000; font-weight: 500;'>Oggetti più brevi (<50 caratteri)</b> funzionano meglio sui <b style='color: #000000; font-weight: 500;'>dispositivi mobili</b>."

#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"<b style='color: #000000; font-weight: 500;'>Birthday or anniversary emails</"
"b> often see <b style='color: #000000; font-weight: 500;'>4x higher "
"engagement</b>."
msgstr "<b style='color: #000000; font-weight: 500;'>Le email di compleanno o anniversario</b> spesso vedono <b style='color: #000000; font-weight: 500;'>4 volte più coinvolgimento</b>."

#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"Avoid <b style='color: #000000; font-weight: 500;'>spammy trigger words</b> "
"like <b style='color: #000000; font-weight: 500;'>free!!!</b>, <b "
"style='color: #000000; font-weight: 500;'>urgent</b>, or <b style='color: "
"#000000; font-weight: 500;'>act now</b> in <b style='color: #000000; font-"
"weight: 500;'>subject lines</b>."
msgstr "Evita <b style='color: #000000; font-weight: 500;'>parole trigger spam</b> come <b style='color: #000000; font-weight: 500;'>gratis!!!</b>, <b style='color: #000000; font-weight: 500;'>urgente</b>, o <b style='color: #000000; font-weight: 500;'>agisci ora</b> negli <b style='color: #000000; font-weight: 500;'>oggetti</b>."

#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"Adding <b style='color: #000000; font-weight: 500;'>emojis to subject lines</"
"b> can <b style='color: #000000; font-weight: 500;'>boost opens</b> \u2014 but "
"use them sparingly."
msgstr "Aggiungere <b style='color: #000000; font-weight: 500;'>emoji agli oggetti</b> può <b style='color: #000000; font-weight: 500;'>aumentare le aperture</b> \u2014 ma usali con parsimonia."

#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"<b style='color: #000000; font-weight: 500;'>Engagement drops</b> when <b "
"style='color: #000000; font-weight: 500;'>sending frequency changes</b> too "
"often."
msgstr "<b style='color: #000000; font-weight: 500;'>Il coinvolgimento diminuisce</b> quando <b style='color: #000000; font-weight: 500;'>la frequenza di invio cambia</b> troppo spesso."

#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"Avoid sending <b style='color: #000000; font-weight: 500;'>too many "
"promotional emails back-to-back</b>."
msgstr "Evita di inviare <b style='color: #000000; font-weight: 500;'>troppe email promozionali consecutive</b>."

#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"Your <b style='color: #000000; font-weight: 500;'>preview text</b> can <b "
"style='color: #000000; font-weight: 500;'>double open rates</b> \u2014 don't "
"leave it blank."
msgstr "Il tuo <b style='color: #000000; font-weight: 500;'>testo di anteprima</b> può <b style='color: #000000; font-weight: 500;'>raddoppiare i tassi di apertura</b> \u2014 non lasciarlo vuoto."

#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"Use <b style='color: #000000; font-weight: 500;'>consistent brand colors and "
"fonts</b> to build <b style='color: #000000; font-weight: 500;'>recognition</"
"b>."
msgstr "Usa <b style='color: #000000; font-weight: 500;'>colori e caratteri del brand coerenti</b> per costruire <b style='color: #000000; font-weight: 500;'>riconoscibilità</b>."

#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"<b style='color: #000000; font-weight: 500;'>White space</b> improves <b "
"style='color: #000000; font-weight: 500;'>readability</b> \u2014 don't cram too "
"much content."
msgstr "<b style='color: #000000; font-weight: 500;'>Lo spazio bianco</b> migliora <b style='color: #000000; font-weight: 500;'>la leggibilità</b> \u2014 non stipare troppo contenuto."

#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"Include <b style='color: #000000; font-weight: 500;'>alt text</b> for all "
"images for <b style='color: #000000; font-weight: 500;'>accessibility and "
"fallback</b>."
msgstr "Includi <b style='color: #000000; font-weight: 500;'>testo alt</b> per tutte le immagini per <b style='color: #000000; font-weight: 500;'>accessibilità e fallback</b>."

#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"Keep <b style='color: #000000; font-weight: 500;'>paragraph length under 3 "
"lines</b> for better <b style='color: #000000; font-weight: 500;'>mobile "
"reading</b>."
msgstr "Mantieni <b style='color: #000000; font-weight: 500;'>la lunghezza dei paragrafi sotto le 3 righe</b> per una migliore <b style='color: #000000; font-weight: 500;'>lettura mobile</b>."

#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"<b style='color: #000000; font-weight: 500;'>Segmenting by engagement score</"
"b> boosts <b style='color: #000000; font-weight: 500;'>deliverability</b>."
msgstr "<b style='color: #000000; font-weight: 500;'>Segmentare per punteggio di coinvolgimento</b> migliora <b style='color: #000000; font-weight: 500;'>la consegnabilità</b>."

#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"<b style='color: #000000; font-weight: 500;'>New subscribers</b> engage <b "
"style='color: #000000; font-weight: 500;'>3x more</b> \u2014 <b style='color: "
"#000000; font-weight: 500;'>nurture them early</b>."
msgstr "<b style='color: #000000; font-weight: 500;'>I nuovi iscritti</b> si impegnano <b style='color: #000000; font-weight: 500;'>3 volte di più</b> \u2014 <b style='color: #000000; font-weight: 500;'>coltivali subito</b>."

#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"Use <b style='color: #000000; font-weight: 500;'>polls or surveys</b> to "
"learn what <b style='color: #000000; font-weight: 500;'>content your "
"subscribers prefer</b>."
msgstr "Usa <b style='color: #000000; font-weight: 500;'>sondaggi o questionari</b> per scoprire quale <b style='color: #000000; font-weight: 500;'>contenuto preferiscono i tuoi iscritti</b>."

#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"Adding a <b style='color: #000000; font-weight: 500;'>P.S. line</b> "
"increases <b style='color: #000000; font-weight: 500;'>responses</b> \u2014 "
"readers often <b style='color: #000000; font-weight: 500;'>skim to it</b>."
msgstr "Aggiungere una <b style='color: #000000; font-weight: 500;'>riga P.S.</b> aumenta <b style='color: #000000; font-weight: 500;'>le risposte</b> \u2014 i lettori spesso <b style='color: #000000; font-weight: 500;'>la leggono per prima</b>."

#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"Get a complete view of your contacts so you can personalize messaging, "
"strengthen relationships."
msgstr "Ottieni una visione completa dei tuoi contatti in modo da poter personalizzare i messaggi e rafforzare le relazioni."

