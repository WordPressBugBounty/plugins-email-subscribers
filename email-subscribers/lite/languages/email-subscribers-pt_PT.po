#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"Emails with <b style='color: #000000; font-weight: 500;'>personalized "
"subject lines</b> get <b style='color: #000000; font-weight: 500;'>higher "
"open rates </b> — try adding the recipient's name."
msgstr ""
"Emails com <b style='color: #000000; font-weight: 500;'>linhas de assunto personalizadas</b> obtêm <b style='color: #000000; font-weight: 500;'>taxas de abertura mais altas</b> — experimente adicionar o nome do destinatário."

#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"<b style='color: #000000; font-weight: 500;'>Resending to non-openers after "
"48 hours</b> can <b style='color: #000000; font-weight: 500;'>increase reach "
"by 10–20%</b>."
msgstr ""
"<b style='color: #000000; font-weight: 500;'>Reenviar para não-abridores após 48 horas</b> pode <b style='color: #000000; font-weight: 500;'>aumentar o alcance em 10–20%</b>."

#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"Adding <b style='color: #000000; font-weight: 500;'>clear CTAs</b> (like "
"'Shop Now' or 'Read More') <b style='color: #000000; font-weight: "
"500;'>improves click rates</b>."
msgstr ""
"Adicionar <b style='color: #000000; font-weight: 500;'>CTAs claros</b> (como 'Compre Agora' ou 'Leia Mais') <b style='color: #000000; font-weight: 500;'>melhora as taxas de cliques</b>."

#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"<b style='color: #000000; font-weight: 500;'>High image-to-text ratio</b> "
"can <b style='color: #000000; font-weight: 500;'> trigger spam filters</b> — "
"maintain balance."
msgstr ""
"<b style='color: #000000; font-weight: 500;'>Proporção alta de imagem para texto</b> pode <b style='color: #000000; font-weight: 500;'>acionar filtros de spam</b> — mantenha o equilíbrio."

#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"<b style='color: #000000; font-weight: 500;'>Geolocation-based timing</b> "
"improves <b style='color: #000000; font-weight: 500;'>open rates for global "
"audiences</b>"
msgstr ""
"<b style='color: #000000; font-weight: 500;'>Temporização baseada em geolocalização</b> melhora <b style='color: #000000; font-weight: 500;'>taxas de abertura para audiências globais</b>"

#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"<b style='color: #000000; font-weight: 500;'>Shorter subject lines (<50 "
"characters)</b> perform better on <b style='color: #000000; font-weight: "
"500;'>mobile devices</b>."
msgstr ""
"<b style='color: #000000; font-weight: 500;'>Linhas de assunto mais curtas (<50 caracteres)</b> têm melhor desempenho em <b style='color: #000000; font-weight: 500;'>dispositivos móveis</b>."

#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"<b style='color: #000000; font-weight: 500;'>Birthday or anniversary emails</"
"b> often see <b style='color: #000000; font-weight: 500;'>4x higher "
"engagement</b>."
msgstr ""
"<b style='color: #000000; font-weight: 500;'>Emails de aniversário ou data comemorativa</b> frequentemente têm <b style='color: #000000; font-weight: 500;'>4x mais envolvimento</b>."

#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"Avoid <b style='color: #000000; font-weight: 500;'>spammy trigger words</b> "
"like <b style='color: #000000; font-weight: 500;'>free!!!</b>, <b "
"style='color: #000000; font-weight: 500;'>urgent</b>, or <b style='color: "
"#000000; font-weight: 500;'>act now</b> in <b style='color: #000000; font-"
"weight: 500;'>subject lines</b>."
msgstr ""
"Evite <b style='color: #000000; font-weight: 500;'>palavras de gatilho de spam</b> como <b style='color: #000000; font-weight: 500;'>grátis!!!</b>, <b style='color: #000000; font-weight: 500;'>urgente</b>, ou <b style='color: #000000; font-weight: 500;'>aja agora</b> em <b style='color: #000000; font-weight: 500;'>linhas de assunto</b>."

#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"Adding <b style='color: #000000; font-weight: 500;'>emojis to subject lines</"
"b> can <b style='color: #000000; font-weight: 500;'>boost opens</b> — but "
"use them sparingly."
msgstr ""
"Adicionar <b style='color: #000000; font-weight: 500;'>emojis às linhas de assunto</b> pode <b style='color: #000000; font-weight: 500;'>aumentar aberturas</b> — mas use-os com moderação."

#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"<b style='color: #000000; font-weight: 500;'>Engagement drops</b> when <b "
"style='color: #000000; font-weight: 500;'>sending frequency changes</b> too "
"often."
msgstr ""
"<b style='color: #000000; font-weight: 500;'>O envolvimento diminui</b> quando a <b style='color: #000000; font-weight: 500;'>frequência de envio muda</b> com muita frequência."

#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"Avoid sending <b style='color: #000000; font-weight: 500;'>too many "
"promotional emails back-to-back</b>."
msgstr ""
"Evite enviar <b style='color: #000000; font-weight: 500;'>emails promocionais demais seguidos</b>."

#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"Your <b style='color: #000000; font-weight: 500;'>preview text</b> can <b "
"style='color: #000000; font-weight: 500;'>double open rates</b> — don't "
"leave it blank."
msgstr ""
"O seu <b style='color: #000000; font-weight: 500;'>texto de pré-visualização</b> pode <b style='color: #000000; font-weight: 500;'>duplicar taxas de abertura</b> — não o deixe em branco."

#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"Use <b style='color: #000000; font-weight: 500;'>consistent brand colors and "
"fonts</b> to build <b style='color: #000000; font-weight: 500;'>recognition</"
"b>."
msgstr ""
"Use <b style='color: #000000; font-weight: 500;'>cores e fontes de marca consistentes</b> para construir <b style='color: #000000; font-weight: 500;'>reconhecimento</b>."

#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"<b style='color: #000000; font-weight: 500;'>White space</b> improves <b "
"style='color: #000000; font-weight: 500;'>readability</b> — don't cram too "
"much content."
msgstr ""
"<b style='color: #000000; font-weight: 500;'>Espaço em branco</b> melhora a <b style='color: #000000; font-weight: 500;'>legibilidade</b> — não encha com muito conteúdo."

#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"Include <b style='color: #000000; font-weight: 500;'>alt text</b> for all "
"images for <b style='color: #000000; font-weight: 500;'>accessibility and "
"fallback</b>."
msgstr ""
"Inclua <b style='color: #000000; font-weight: 500;'>texto alternativo</b> para todas as imagens para <b style='color: #000000; font-weight: 500;'>acessibilidade e reserva</b>."

#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"Keep <b style='color: #000000; font-weight: 500;'>paragraph length under 3 "
"lines</b> for better <b style='color: #000000; font-weight: 500;'>mobile "
"reading</b>."
msgstr ""
"Mantenha o <b style='color: #000000; font-weight: 500;'>comprimento do parágrafo abaixo de 3 linhas</b> para melhor <b style='color: #000000; font-weight: 500;'>leitura em dispositivos móveis</b>."

#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"<b style='color: #000000; font-weight: 500;'>Segmenting by engagement score</"
"b> boosts <b style='color: #000000; font-weight: 500;'>deliverability</b>."
msgstr ""
"<b style='color: #000000; font-weight: 500;'>Segmentar por pontuação de envolvimento</b> aumenta a <b style='color: #000000; font-weight: 500;'>entregabilidade</b>."

#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"<b style='color: #000000; font-weight: 500;'>New subscribers</b> engage <b "
"style='color: #000000; font-weight: 500;'>3x more</b> — <b style='color: "
"#000000; font-weight: 500;'>nurture them early</b>."
msgstr ""
"<b style='color: #000000; font-weight: 500;'>Novos subscritores</b> envolvem-se <b style='color: #000000; font-weight: 500;'>3x mais</b> — <b style='color: #000000; font-weight: 500;'>cultive-os cedo</b>."

#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"Use <b style='color: #000000; font-weight: 500;'>polls or surveys</b> to "
"learn what <b style='color: #000000; font-weight: 500;'>content your "
"subscribers prefer</b>."
msgstr ""
"Use <b style='color: #000000; font-weight: 500;'>sondagens ou questionários</b> para saber que <b style='color: #000000; font-weight: 500;'>conteúdo os seus subscritores preferem</b>."

#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"Adding a <b style='color: #000000; font-weight: 500;'>P.S. line</b> "
"increases <b style='color: #000000; font-weight: 500;'>responses</b> — "
"readers often <b style='color: #000000; font-weight: 500;'>skim to it</b>."
msgstr ""
"Adicionar uma <b style='color: #000000; font-weight: 500;'>linha P.S.</b> aumenta <b style='color: #000000; font-weight: 500;'>respostas</b> — os leitores frequentemente <b style='color: #000000; font-weight: 500;'>passam os olhos por ela</b>."

#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"Get a complete view of your contacts so you can personalize messaging, "
"strengthen relationships."
msgstr ""
"Obtenha uma visão completa dos seus contactos para que possa personalizar mensagens, fortalecer relacionamentos."

