#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"Emails with <b style='color: #000000; font-weight: 500;'>personalized "
"subject lines</b> get <b style='color: #000000; font-weight: 500;'>higher "
"open rates </b> — try adding the recipient's name."
msgstr ""
"Les emails avec <b style='color: #000000; font-weight: 500;'>des lignes de "
"sujet personnalisées</b> obtiennent <b style='color: #000000; font-weight: 500;'>des "
"taux d'ouverture plus élevés</b> — essayez d'ajouter le nom du destinataire."

#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"<b style='color: #000000; font-weight: 500;'>Resending to non-openers after "
"48 hours</b> can <b style='color: #000000; font-weight: 500;'>increase reach "
"by 10–20%</b>."
msgstr ""
"<b style='color: #000000; font-weight: 500;'>Renvoyer aux non-ouvreurs après "
"48 heures</b> peut <b style='color: #000000; font-weight: 500;'>augmenter la portée "
"de 10 à 20%</b>."

#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"Adding <b style='color: #000000; font-weight: 500;'>clear CTAs</b> (like "
"'Shop Now' or 'Read More') <b style='color: #000000; font-weight: "
"500;'>improves click rates</b>."
msgstr ""
"Ajouter des <b style='color: #000000; font-weight: 500;'>CTA clairs</b> (comme "
"'Acheter maintenant' ou 'En savoir plus') <b style='color: #000000; font-weight: "
"500;'>améliore les taux de clic</b>."

#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"<b style='color: #000000; font-weight: 500;'>High image-to-text ratio</b> "
"can <b style='color: #000000; font-weight: 500;'> trigger spam filters</b> — "
"maintain balance."
msgstr ""
"Un <b style='color: #000000; font-weight: 500;'>rapport image/texte élevé</b> "
"peut <b style='color: #000000; font-weight: 500;'> déclencher les filtres anti-spam</b> — "
"maintenez l'équilibre."

#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"<b style='color: #000000; font-weight: 500;'>Geolocation-based timing</b> "
"improves <b style='color: #000000; font-weight: 500;'>open rates for global "
"audiences</b>"
msgstr ""
"Le <b style='color: #000000; font-weight: 500;'>timing basé sur la géolocalisation</b> "
"améliore <b style='color: #000000; font-weight: 500;'>les taux d'ouverture pour les "
"audiences mondiales</b>"

#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"<b style='color: #000000; font-weight: 500;'>Shorter subject lines (<50 "
"characters)</b> perform better on <b style='color: #000000; font-weight: "
"500;'>mobile devices</b>."
msgstr ""
"Les <b style='color: #000000; font-weight: 500;'>lignes de sujet plus courtes (<50 "
"caractères)</b> fonctionnent mieux sur les <b style='color: #000000; font-weight: "
"500;'>appareils mobiles</b>."

#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"<b style='color: #000000; font-weight: 500;'>Birthday or anniversary emails</"
"b> often see <b style='color: #000000; font-weight: 500;'>4x higher "
"engagement</b>."
msgstr ""

#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"Avoid <b style='color: #000000; font-weight: 500;'>spammy trigger words</b> "
"like <b style='color: #000000; font-weight: 500;'>free!!!</b>, <b "
"style='color: #000000; font-weight: 500;'>urgent</b>, or <b style='color: "
"#000000; font-weight: 500;'>act now</b> in <b style='color: #000000; font-"
"weight: 500;'>subject lines</b>."
msgstr ""
"Évitez les <b style='color: #000000; font-weight: 500;'>mots déclencheurs de spam</b> "
"comme <b style='color: #000000; font-weight: 500;'>gratuit !!!</b>, <b "
"style='color: #000000; font-weight: 500;'>urgent</b>, ou <b style='color: "
"#000000; font-weight: 500;'>agissez maintenant</b> dans les <b style='color: #000000; font-"
"weight: 500;'>lignes de sujet</b>."

#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"Adding <b style='color: #000000; font-weight: 500;'>emojis to subject lines</"
"b> can <b style='color: #000000; font-weight: 500;'>boost opens</b> — but "
"use them sparingly."
msgstr ""
"Ajouter des <b style='color: #000000; font-weight: 500;'>émojis aux lignes de sujet</"
"b> peut <b style='color: #000000; font-weight: 500;'>augmenter les ouvertures</b> — mais "
"utilisez-les avec modération."

#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"<b style='color: #000000; font-weight: 500;'>Engagement drops</b> when <b "
"style='color: #000000; font-weight: 500;'>sending frequency changes</b> too "
"often."
msgstr ""
"L'<b style='color: #000000; font-weight: 500;'>engagement diminue</b> lorsque la <b "
"style='color: #000000; font-weight: 500;'>fréquence d'envoi change</b> trop "
"souvent."

#: lite/admin/shadcn-frontend/dist/index.js:50
msgid ""
"Avoid sending <b style='color: #000000; font-weight: 500;'>too many "
