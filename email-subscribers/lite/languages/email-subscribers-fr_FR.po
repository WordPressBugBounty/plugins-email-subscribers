msgid ""
"Icegram Express - Email Subscribers, Newsletters and Marketing Automation "
"Plugin"
msgstr ""
"Icegram Express - Plugin d'abonnés email, newsletters et automatisation "
"marketing"

#. Plugin URI of the plugin
#. Author URI of the plugin
#: email-subscribers.php lite/language.php:7
msgid "https://www.icegram.com/"
msgstr "https://www.icegram.com/"

#. Description of the plugin
#: email-subscribers.php lite/language.php:9
msgid ""
"Add subscription forms on website, send HTML newsletters & automatically "
"notify subscribers about new blog posts once it is published."
msgstr ""
"Ajoutez des formulaires d'abonnement sur le site web, envoyez des "
"newsletters HTML et notifiez automatiquement les abonnés des nouveaux "
"articles de blog une fois publiés."

#. Author of the plugin
#: email-subscribers.php lite/includes/class-email-subscribers.php:1615
#: lite/language.php:11
